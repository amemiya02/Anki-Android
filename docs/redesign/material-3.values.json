{
    "direction": "Material 3 standard",
    "note": "The design values of the chosen Direction (ADR-0006), as one list. The Foundation is built from it and FoundationTest fails if a resource drifts from it. Sizes are in dp for layout and sp for text.",
    "typefaces": {
        "interface": "sans-serif",
        "rule": "Interface text uses the system sans-serif: Roboto, and the system's CJK font for Chinese and Japanese, chosen by the interface language. No interface font is bundled. Hierarchy uses size and weight only."
    },
    "icons": {
        "family": "Material Symbols Outlined",
        "weight": 300,
        "fill": 0,
        "grade": 0,
        "opticalSize": 24,
        "size": 24
    },
    "type": [
        {
            "role": "screenTitle",
            "size": 32,
            "weight": 400,
            "lineHeight": 1.25,
            "use": "The title of a top-level screen (Material 3 headline large)"
        },
        {
            "role": "pageTitle",
            "size": 28,
            "weight": 400,
            "lineHeight": 1.2857,
            "use": "The heading of the finished screen and of an empty screen (headline medium)"
        },
        {
            "role": "dialogTitle",
            "size": 24,
            "weight": 400,
            "lineHeight": 1.3333,
            "use": "The title of a dialog (headline small)"
        },
        {
            "role": "deckName",
            "size": 16,
            "weight": 500,
            "lineHeight": 1.5,
            "use": "A top-level Deck in the deck list (title medium)"
        },
        {
            "role": "deckNameNested",
            "size": 16,
            "weight": 400,
            "lineHeight": 1.5,
            "use": "A Deck inside another Deck (body large)"
        },
        {
            "role": "summary",
            "size": 22,
            "weight": 400,
            "lineHeight": 1.2727,
            "use": "The line that says what is due today (title large)"
        },
        {
            "role": "count",
            "size": 14,
            "weight": 500,
            "lineHeight": 1.4286,
            "use": "A new, learning or due count (label large)",
            "figures": "tabular"
        },
        {
            "role": "studyTitle",
            "size": 16,
            "weight": 500,
            "lineHeight": 1.5,
            "use": "The Deck name on the study screen (title medium)"
        },
        {
            "role": "button",
            "size": 14,
            "weight": 500,
            "lineHeight": 1.4286,
            "use": "The label of a button (label large)"
        },
        {
            "role": "rowTitle",
            "size": 16,
            "weight": 400,
            "lineHeight": 1.5,
            "use": "The headline of a row in a list (body large)"
        },
        {
            "role": "lead",
            "size": 16,
            "weight": 400,
            "lineHeight": 1.5,
            "use": "The explanation under a page title (body large)"
        },
        {
            "role": "answer",
            "size": 16,
            "weight": 500,
            "lineHeight": 1.5,
            "use": "Again, Hard, Good and Easy (title medium)"
        },
        {
            "role": "editorField",
            "size": 16,
            "weight": 400,
            "lineHeight": 1.5,
            "use": "Editable field content in the Note Editor (body large)"
        },
        {
            "role": "body",
            "size": 14,
            "weight": 400,
            "lineHeight": 1.4286,
            "use": "Ordinary interface text (body medium)"
        },
        {
            "role": "studyCount",
            "size": 14,
            "weight": 500,
            "lineHeight": 1.4286,
            "use": "Remaining counts on the study screen (label large)",
            "figures": "tabular"
        },
        {
            "role": "caption",
            "size": 12,
            "weight": 400,
            "lineHeight": 1.3333,
            "use": "Dates and secondary lines (body small)"
        },
        {
            "role": "label",
            "size": 12,
            "weight": 500,
            "lineHeight": 1.3333,
            "use": "Column headings, navigation labels, answer intervals (label medium)"
        }
    ],
    "spacing": {
        "scale": [4, 8, 12, 16, 20, 24, 32],
        "screenMargin": 16,
        "studyMargin": 16,
        "touchTarget": 48,
        "deckRow": 56,
        "deckRowNested": 48,
        "countColumn": 40,
        "primaryButton": 56,
        "answerButton": 56,
        "addButton": 56,
        "bottomBar": 80,
