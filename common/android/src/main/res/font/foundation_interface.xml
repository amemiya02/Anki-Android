<!--
  The interface face: Newsreader, one variable font, instanced at each weight.
  Android 10 and later draw interface text with InterfaceTypeface.kt instead, which falls back from
  Newsreader to the Chinese or Japanese face. This single face serves older versions, and text the app
  sets up without its layout inflater (for example toolbar titles).
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/newsreader"
        android:fontStyle="normal"
        android:fontWeight="400"
        android:fontVariationSettings="'wght' 400"
        app:fontVariationSettings="'wght' 400"
        app:font="@font/newsreader"
        app:fontStyle="normal"
        app:fontWeight="400" />
    <font
        android:font="@font/newsreader"
        android:fontStyle="normal"
        android:fontWeight="500"
        android:fontVariationSettings="'wght' 500"
        app:fontVariationSettings="'wght' 500"
        app:font="@font/newsreader"
        app:fontStyle="normal"
        app:fontWeight="500" />
    <font
        android:font="@font/newsreader"
        android:fontStyle="normal"
        android:fontWeight="600"
        android:fontVariationSettings="'wght' 600"
        app:fontVariationSettings="'wght' 600"
        app:font="@font/newsreader"
        app:fontStyle="normal"
        app:fontWeight="600" />
    <font
        android:font="@font/newsreader"
        android:fontStyle="normal"
        android:fontWeight="700"
        android:fontVariationSettings="'wght' 700"
        app:fontVariationSettings="'wght' 700"
        app:font="@font/newsreader"
        app:fontStyle="normal"
        app:fontWeight="700" />
</font-family>
