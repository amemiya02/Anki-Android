<?xml version="1.0" encoding="utf-8"?>

<!--
  Dark: the same mapping as theme_light.xml over the Dark colours; keep the two in step.
  Black (theme_black.xml) inherits it and replaces only the colours that differ.
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="DuplicateCrowdInStrings">
    <style name="Base.Theme.Dark" parent="@style/Theme.Material3.Dark.NoActionBar">
        <!-- Foundation colour roles -->
        <item name="foundationBackground">@color/foundation_dark_background</item>
        <item name="foundationStudyCanvas">@color/foundation_dark_study_canvas</item>
        <item name="foundationOnBackground">@color/foundation_dark_on_background</item>
        <item name="foundationOnBackgroundMuted">@color/foundation_dark_on_background_muted</item>
        <item name="foundationOutline">@color/foundation_dark_outline</item>
        <item name="foundationDialogBorder">?attr/foundationOutline</item>
        <item name="foundationPrimary">@color/foundation_dark_primary</item>
        <item name="foundationOnPrimary">@color/foundation_dark_on_primary</item>
        <item name="foundationEmphasis">@color/foundation_dark_emphasis</item>
        <item name="foundationCountNew">@color/foundation_dark_count_new</item>
        <item name="foundationCountLearning">@color/foundation_dark_count_learning</item>
        <item name="foundationCountDue">@color/foundation_dark_count_due</item>
        <item name="foundationAnswerAgain">@color/foundation_dark_answer_again</item>
        <item name="foundationAnswerHard">@color/foundation_dark_answer_hard</item>
        <item name="foundationAnswerGood">@color/foundation_dark_answer_good</item>
        <item name="foundationAnswerEasy">@color/foundation_dark_answer_easy</item>
        <item name="foundationFlagRed">@color/foundation_dark_flag_red</item>
        <item name="foundationFlagOrange">@color/foundation_dark_flag_orange</item>
        <item name="foundationFlagGreen">@color/foundation_dark_flag_green</item>
        <item name="foundationFlagBlue">@color/foundation_dark_flag_blue</item>
        <item name="foundationFlagPink">@color/foundation_dark_flag_pink</item>
        <item name="foundationFlagTurquoise">@color/foundation_dark_flag_turquoise</item>
        <item name="foundationFlagPurple">@color/foundation_dark_flag_purple</item>
        <item name="foundationProgressTrack">@color/foundation_dark_progress_track</item>
        <item name="foundationProgressFill">@color/foundation_dark_progress_fill</item>

        <!--
          Material 3 roles: the default Hayaki palette, generated into foundation_colors.xml.
        -->
        <item name="colorPrimary">@color/scheme_dark_primary</item>
        <!-- The emphasis colour is light here, so ink on it reads; the light on-primary does not -->
        <item name="colorOnPrimary">@color/scheme_dark_on_primary</item>
        <item name="colorPrimaryContainer">@color/scheme_dark_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/scheme_dark_on_primary_container</item>
        <item name="colorSecondary">@color/scheme_dark_secondary</item>
        <item name="colorOnSecondary">@color/scheme_dark_on_secondary</item>
        <item name="colorSecondaryContainer">@color/scheme_dark_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/scheme_dark_on_secondary_container</item>
        <item name="colorTertiary">@color/scheme_dark_tertiary</item>
        <item name="colorOnTertiary">@color/scheme_dark_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/scheme_dark_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/scheme_dark_on_tertiary_container</item>
        <item name="colorError">@color/scheme_dark_error</item>
        <item name="colorOnError">@color/scheme_dark_on_error</item>
        <item name="colorErrorContainer">@color/scheme_dark_error_container</item>
        <item name="colorOnErrorContainer">@color/scheme_dark_on_error_container</item>
        <item name="colorSurface">@color/scheme_dark_surface</item>
        <item name="colorOnSurface">@color/scheme_dark_on_surface</item>
        <item name="colorOnBackground">@color/scheme_dark_on_surface</item>
        <item name="colorSurfaceVariant">@color/scheme_dark_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/scheme_dark_on_surface_variant</item>
        <!-- `colorOutline` bounds controls such as text fields, so it must be seen; dividers are hairlines -->
        <item name="colorOutline">@color/scheme_dark_outline</item>
        <item name="colorOutlineVariant">@color/scheme_dark_outline_variant</item>
        <item name="colorSurfaceContainerLowest">@color/scheme_dark_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/scheme_dark_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/scheme_dark_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/scheme_dark_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/scheme_dark_surface_container_highest</item>
        <item name="colorSurfaceDim">@color/scheme_dark_surface_dim</item>
        <item name="colorSurfaceBright">@color/scheme_dark_surface_bright</item>
        <item name="colorSurfaceInverse">@color/scheme_dark_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/scheme_dark_inverse_on_surface</item>
        <item name="colorPrimaryInverse">@color/scheme_dark_inverse_primary</item>
        <!-- Fixed roles stay the same across light and dark appearances -->
        <item name="colorPrimaryFixed">@color/scheme_primary_fixed</item>
        <item name="colorPrimaryFixedDim">@color/scheme_primary_fixed_dim</item>
        <item name="colorOnPrimaryFixed">@color/scheme_on_primary_fixed</item>
        <item name="colorOnPrimaryFixedVariant">@color/scheme_on_primary_fixed_variant</item>
        <item name="colorSecondaryFixed">@color/scheme_secondary_fixed</item>
        <item name="colorSecondaryFixedDim">@color/scheme_secondary_fixed_dim</item>
        <item name="colorOnSecondaryFixed">@color/scheme_on_secondary_fixed</item>
        <item name="colorOnSecondaryFixedVariant">@color/scheme_on_secondary_fixed_variant</item>
        <item name="colorTertiaryFixed">@color/scheme_tertiary_fixed</item>
        <item name="colorTertiaryFixedDim">@color/scheme_tertiary_fixed_dim</item>
        <item name="colorOnTertiaryFixed">@color/scheme_on_tertiary_fixed</item>
        <item name="colorOnTertiaryFixedVariant">@color/scheme_on_tertiary_fixed_variant</item>
        <item name="android:colorBackground">?attr/foundationBackground</item>
        <item name="android:windowBackground">?attr/foundationBackground</item>
        <item name="android:textColorHint">@color/hint_text_color</item>
        <item name="android:textColor">@color/text_color_primary</item>
        <item name="android:textColorPrimary">@color/text_color_primary</item>
        <item name="android:textColorSecondary">@color/text_color_secondary</item>
        <item name="android:textColorTertiary">@color/text_color_secondary</item>
        <item name="android:textColorHighlight">?attr/colorSecondaryContainer</item>

        <!--
          Foundation type: interface text falls back to the interface typeface, and Material 3's type
          slots are the Foundation's styles (foundation.xml). Keep Light and Dark in step.
        -->
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <!-- Redraws inflated text in the interface typeface: the system sans-serif at the style's weight -->
        <item name="viewInflaterClass">com.ichi2.anki.common.android.themes.FoundationViewInflater</item>
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.Foundation.ScreenTitle</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.Foundation.ScreenTitle</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.Foundation.ScreenTitle</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.Foundation.ScreenTitle</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.Foundation.PageTitle</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Foundation.DialogTitle</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Foundation.Summary</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Foundation.DeckName</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.Foundation.Button</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Foundation.Lead</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Foundation.Body</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Foundation.Caption</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Foundation.Button</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.Foundation.Label</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.Foundation.Label</item>
        <item name="android:textAppearance">@style/TextAppearance.Foundation.Body</item>
        <item name="android:textAppearanceSmall">@style/TextAppearance.Foundation.Body</item>
        <item name="android:textAppearanceMedium">@style/TextAppearance.Foundation.Lead</item>
        <item name="android:textAppearanceLarge">@style/TextAppearance.Foundation.Summary</item>
        <item name="android:textAppearanceListItem">@style/TextAppearance.Foundation.Lead</item>
        <item name="android:textAppearanceListItemSmall">@style/TextAppearance.Foundation.Body</item>
        <item name="android:textAppearanceListItemSecondary">@style/TextAppearance.Foundation.Caption</item>
        <!-- Older type slots that AppCompat and Material 2 widgets still read -->
        <item name="textAppearanceHeadline1">@style/TextAppearance.Foundation.ScreenTitle</item>
        <item name="textAppearanceHeadline2">@style/TextAppearance.Foundation.ScreenTitle</item>
        <item name="textAppearanceHeadline3">@style/TextAppearance.Foundation.ScreenTitle</item>
        <item name="textAppearanceHeadline4">@style/TextAppearance.Foundation.PageTitle</item>
        <item name="textAppearanceHeadline5">@style/TextAppearance.Foundation.DialogTitle</item>
        <item name="textAppearanceHeadline6">@style/TextAppearance.Foundation.Summary</item>
        <item name="textAppearanceSubtitle1">@style/TextAppearance.Foundation.DeckName</item>
        <item name="textAppearanceSubtitle2">@style/TextAppearance.Foundation.Button</item>
        <item name="textAppearanceBody1">@style/TextAppearance.Foundation.Lead</item>
        <item name="textAppearanceBody2">@style/TextAppearance.Foundation.Body</item>
        <item name="textAppearanceCaption">@style/TextAppearance.Foundation.Caption</item>
        <item name="textAppearanceButton">@style/TextAppearance.Foundation.Button</item>
        <item name="textAppearanceOverline">@style/TextAppearance.Foundation.Label</item>
        <item name="textAppearanceListItem">@style/TextAppearance.Foundation.Lead</item>
        <item name="textAppearanceListItemSmall">@style/TextAppearance.Foundation.Body</item>
        <item name="textAppearanceListItemSecondary">@style/TextAppearance.Foundation.Caption</item>

        <!-- Foundation shapes and elevation -->
        <item name="shapeCornerSizeExtraSmall">@dimen/foundation_shape_extra_small</item>
        <item name="shapeCornerSizeSmall">@dimen/foundation_shape_small</item>
        <item name="shapeCornerSizeMedium">@dimen/foundation_shape_medium</item>
        <item name="shapeCornerSizeLarge">@dimen/foundation_shape_large</item>
        <item name="shapeCornerSizeLargeIncreased">@dimen/foundation_shape_large</item>
        <item name="shapeCornerSizeExtraLarge">@dimen/foundation_shape_extra_large</item>
        <item name="shapeCornerSizeExtraLargeIncreased">@dimen/foundation_shape_extra_large</item>
        <item name="shapeCornerSizeExtraExtraLarge">@dimen/foundation_shape_extra_large</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Foundation.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Foundation.CardSheet</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Foundation.Dialog</item>
        <item name="materialButtonStyle">@style/Widget.Foundation.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Foundation.Button.Outlined</item>
        <item name="materialCardViewStyle">@style/Widget.Foundation.Card</item>
        <item name="floatingActionButtonStyle">@style/Widget.Foundation.AddButton</item>
        <item name="elevationOverlayEnabled">false</item>

        <item name="preferenceCategoryTitleTextColor">?attr/foundationOnBackgroundMuted</item>
        <!-- Navigation drawer theme -->
        <item name="navDrawerItemColor">@color/drawer_item_text</item>
        <item name="navDrawerItemBackground">@drawable/drawer_item_background</item>
        <!-- Menu -->
        <!-- Icons the platform draws: the up arrow, the overflow menu, the search field -->
        <item name="homeAsUpIndicator">@drawable/symbol_arrow_back</item>
        <item name="actionOverflowButtonStyle">@style/Widget.Foundation.OverflowButton</item>
        <item name="searchViewStyle">@style/Widget.Foundation.SearchView</item>
        <item name="actionOverflowMenuStyle">@style/OverflowMenuStyle</item>
        <item name="popupMenuStyle">@style/PopupMenuStyle</item>
        <item name="spinnerStyle">@style/SpinnerStyle</item>
        <!-- Action bar styles: the top app bar is the surface -->
        <item name="appBarColor">?attr/foundationBackground</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionModeOverlay">true</item>
        <item name="actionBarTextColor">?attr/foundationOnBackground</item>
        <item name="actionModeBackground">?attr/appBarColor</item>
        <!-- Bottom navigation -->
        <item name="bottomNavIndicatorColor">?attr/colorSecondaryContainer</item>
        <item name="bottomNavActiveIconColor">?attr/colorOnSecondaryContainer</item>
        <!-- Deck list colors -->
        <item name="selectedRowBackgroundColor">?attr/colorSecondaryContainer</item>
        <item name="dynDeckColor">?attr/foundationCountNew</item>
        <!-- Count colors -->
        <item name="newCountColor">?attr/foundationCountNew</item>
        <item name="learnCountColor">?attr/foundationCountLearning</item>
        <item name="reviewCountColor">?attr/foundationCountDue</item>
        <item name="buryCountColor">?attr/foundationOnBackgroundMuted</item>
        <item name="zeroCountColor">?attr/foundationOnBackgroundMuted</item>
        <!-- Study Screen colors: answer buttons are tonal pills, labelled in their answer colour -->
        <item name="againButtonBackground">?attr/colorSurfaceContainerHigh</item>
        <item name="hardButtonBackground">?attr/colorSurfaceContainerHigh</item>
        <item name="goodButtonBackground">?attr/colorSurfaceContainerHigh</item>
        <item name="easyButtonBackground">?attr/colorSurfaceContainerHigh</item>
        <item name="topBarColor">?attr/foundationBackground</item>
        <item name="maxTimerColor">?attr/colorError</item>
        <!-- the old study screen's Show answer bar and the strip below its answer buttons are paper, like the buttons -->
        <item name="showAnswerTextColor">?attr/foundationOnBackground</item>
        <item name="againButtonTextColor">?attr/foundationAnswerAgain</item>
        <item name="hardButtonTextColor">?attr/foundationAnswerHard</item>
        <item name="goodButtonTextColor">?attr/foundationAnswerGood</item>
        <item name="easyButtonTextColor">?attr/foundationAnswerEasy</item>
        <item name="againTextColor">?attr/foundationAnswerAgain</item>
        <item name="hardTextColor">?attr/foundationAnswerHard</item>
        <item name="goodTextColor">?attr/foundationAnswerGood</item>
        <item name="easyTextColor">?attr/foundationAnswerEasy</item>
        <item name="againBackgroundColor">?attr/colorSurfaceContainerHigh</item>
        <item name="hardBackgroundColor">?attr/colorSurfaceContainerHigh</item>
        <item name="goodBackgroundColor">?attr/colorSurfaceContainerHigh</item>
        <item name="easyBackgroundColor">?attr/colorSurfaceContainerHigh</item>
        <item name="againIconColor">?againTextColor</item>
        <item name="hardIconColor">?hardTextColor</item>
        <item name="goodIconColor">?goodTextColor</item>
        <item name="easyIconColor">?easyTextColor</item>
        <!-- Study Screen button drawables -->
        <item name="showAnswerButtonBackground">?attr/foundationPrimary</item>
        <item name="showAnswerColor">?attr/foundationOnPrimary</item>
        <item name="answerButtonRef">@drawable/footer_button</item>
        <item name="answerButtonRippleRef">@drawable/footer_button_ripple</item>
        <!-- Card Browser Colors -->
        <item name="cardBrowserDivider">?attr/foundationOutline</item>
        <!-- Browser colors -->
        <item name="suspendedColor">@color/material_grey_700</item>
        <item name="buriedColor">#612B09</item>
        <item name="markedColor">@color/material_deep_purple_400</item>
        <!-- Note editor colors -->
        <item name="duplicateColor">#855</item>
        <item name="toolbarBackgroundColor">?attr/foundationBackground</item>
        <item name="buttonShadowColor">#bdbdbd</item>
        <item name="buttonRippleColor">#BABABA</item>
        <item name="buttonForegroundColor">?attr/foundationProgressTrack</item>
        <!-- FAB: the add button, Material 3's primary-container FAB -->
        <item name="fabNormalColor">?attr/colorPrimaryContainer</item>
        <item name="fabPressedColor">?attr/colorPrimaryContainer</item>
        <!-- Dialog styles -->
        <item name="android:listPreferredItemHeight">56dip</item>
        <item name="dialogCornerRadius">@dimen/dialog_corner_radius</item>
        <item name="android:dialogCornerRadius" tools:targetApi="p">@dimen/dialog_corner_radius</item>
        <item name="textAllCaps">false</item>
        <item name="popupBackgroundColor">?attr/colorSurfaceContainer</item>
        <item name="overflowAndPopupMenuIconColor">@color/overflow_menu_icon_color</item>
        <!-- StatusBar -->
        <item name="android:statusBarColor">?attr/foundationBackground</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Navbar -->
        <item name="android:navigationBarColor">?attr/foundationBackground</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>

        <!-- Widget styles -->
        <item name="alertDialogTheme">@style/ThemeOverlay.AnkiDroid.AlertDialog</item>

        <item name="tabStyle">@style/Widget.MaterialComponents.TabLayout</item>

        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.App.BottomSheetDialog</item>


        <item name="clozeColor">?attr/foundationCountNew</item>

        <item name="incrementerButtonBackground">?attr/foundationPrimary</item>

        <!-- Reminder troubleshooting - check contrast before changing -->
        <item name="reminderTroubleshootingOk">?attr/foundationCountDue</item>
        <item name="reminderTroubleshootingWarning">?attr/colorError</item>


        <item name="badgeErrorColor">?attr/colorError</item>
        <item name="badgeWarningColor">?attr/colorError</item>
        <!-- Widget outlines -->
        <item name="widgetStrokeWidth">@dimen/foundation_shape_hairline</item>
        <item name="widgetStrokeColor">?attr/foundationOutline</item>
        <item name="studyScreenElevation">@dimen/foundation_elevation_flat</item>
        <item name="whiteboardToolbarCardStyle">?attr/materialCardViewStyle</item>
    </style>

    <style name="Theme_Dark" parent="Base.Theme.Dark"/>
</resources>
