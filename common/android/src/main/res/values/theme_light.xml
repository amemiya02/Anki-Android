<?xml version="1.0" encoding="utf-8"?>

<!--
  Light: the Foundation's colour roles (foundation.xml), and the Material 3 and app roles mapped onto
  them. theme_dark.xml repeats the same mapping over the Dark colours; keep the two in step.
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="DuplicateCrowdInStrings">
    <style name="Base.Theme.Light" parent="@style/Theme.Material3.Light.NoActionBar">
        <!-- Foundation colour roles -->
        <item name="foundationBackground">@color/foundation_light_background</item>
        <item name="foundationOnBackground">@color/foundation_light_on_background</item>
        <item name="foundationOnBackgroundMuted">@color/foundation_light_on_background_muted</item>
        <item name="foundationOutline">@color/foundation_light_outline</item>
        <item name="foundationDialogBorder">?attr/foundationOutline</item>
        <item name="foundationPrimary">@color/foundation_light_primary</item>
        <item name="foundationOnPrimary">@color/foundation_light_on_primary</item>
        <item name="foundationEmphasis">@color/foundation_light_emphasis</item>
        <item name="foundationCountNew">@color/foundation_light_count_new</item>
        <item name="foundationCountLearning">@color/foundation_light_count_learning</item>
        <item name="foundationCountDue">@color/foundation_light_count_due</item>
        <item name="foundationAnswerAgain">@color/foundation_light_answer_again</item>
        <item name="foundationAnswerHard">@color/foundation_light_answer_hard</item>
        <item name="foundationAnswerGood">@color/foundation_light_answer_good</item>
        <item name="foundationAnswerEasy">@color/foundation_light_answer_easy</item>
        <item name="foundationFlagRed">@color/foundation_light_flag_red</item>
        <item name="foundationFlagOrange">@color/foundation_light_flag_orange</item>
        <item name="foundationFlagGreen">@color/foundation_light_flag_green</item>
        <item name="foundationFlagBlue">@color/foundation_light_flag_blue</item>
        <item name="foundationFlagPink">@color/foundation_light_flag_pink</item>
        <item name="foundationFlagTurquoise">@color/foundation_light_flag_turquoise</item>
        <item name="foundationFlagPurple">@color/foundation_light_flag_purple</item>
        <item name="foundationProgressTrack">@color/foundation_light_progress_track</item>
        <item name="foundationProgressFill">@color/foundation_light_progress_fill</item>

        <!--
          Material 3 roles. Material uses `colorPrimary` mostly as text and marks on the background,
          so it takes the emphasis colour, which is checked as text; `colorOnPrimary` is chosen to read
          on it. Containers and surfaces are the background: surfaces are flat, not tonal.
        -->
        <item name="colorPrimary">?attr/foundationEmphasis</item>
        <item name="colorOnPrimary">?attr/foundationOnPrimary</item>
        <item name="colorPrimaryContainer">?attr/foundationProgressTrack</item>
        <item name="colorOnPrimaryContainer">?attr/foundationOnBackground</item>
        <item name="colorSecondary">?attr/foundationOnBackgroundMuted</item>
        <item name="colorOnSecondary">?attr/foundationBackground</item>
        <item name="colorSecondaryContainer">?attr/foundationProgressTrack</item>
        <item name="colorOnSecondaryContainer">?attr/foundationOnBackground</item>
        <item name="colorTertiary">?attr/foundationCountNew</item>
        <item name="colorOnTertiary">?attr/foundationBackground</item>
        <item name="colorTertiaryContainer">?attr/foundationProgressTrack</item>
        <item name="colorOnTertiaryContainer">?attr/foundationOnBackground</item>
        <item name="colorError">?attr/foundationEmphasis</item>
        <item name="colorOnError">?attr/colorOnPrimary</item>
        <item name="colorErrorContainer">?attr/foundationProgressTrack</item>
        <item name="colorOnErrorContainer">?attr/foundationOnBackground</item>
        <item name="colorSurface">?attr/foundationBackground</item>
        <item name="colorOnSurface">?attr/foundationOnBackground</item>
        <item name="colorOnBackground">?attr/foundationOnBackground</item>
        <item name="colorSurfaceVariant">?attr/foundationBackground</item>
        <item name="colorOnSurfaceVariant">?attr/foundationOnBackgroundMuted</item>
        <!-- `colorOutline` bounds controls such as text fields, so it must be seen; dividers are hairlines -->
        <item name="colorOutline">?attr/foundationOnBackgroundMuted</item>
        <item name="colorOutlineVariant">?attr/foundationOutline</item>
        <item name="colorSurfaceContainerLowest">?attr/foundationBackground</item>
        <item name="colorSurfaceContainerLow">?attr/foundationBackground</item>
        <item name="colorSurfaceContainer">?attr/foundationBackground</item>
        <item name="colorSurfaceContainerHigh">?attr/foundationBackground</item>
        <item name="colorSurfaceContainerHighest">?attr/foundationProgressTrack</item>
        <item name="colorSurfaceDim">?attr/foundationBackground</item>
        <item name="colorSurfaceBright">?attr/foundationBackground</item>
        <item name="colorSurfaceInverse">?attr/foundationOnBackground</item>
        <item name="colorOnSurfaceInverse">?attr/foundationBackground</item>
        <item name="colorPrimaryInverse">@color/foundation_dark_emphasis</item>
        <!-- Fixed roles are the same in every theme -->
        <item name="colorPrimaryFixed">@color/foundation_light_progress_track</item>
        <item name="colorPrimaryFixedDim">@color/foundation_light_outline</item>
        <item name="colorOnPrimaryFixed">@color/foundation_light_on_background</item>
        <item name="colorOnPrimaryFixedVariant">@color/foundation_light_on_background_muted</item>
        <item name="colorSecondaryFixed">@color/foundation_light_progress_track</item>
        <item name="colorSecondaryFixedDim">@color/foundation_light_outline</item>
        <item name="colorOnSecondaryFixed">@color/foundation_light_on_background</item>
        <item name="colorOnSecondaryFixedVariant">@color/foundation_light_on_background_muted</item>
        <item name="colorTertiaryFixed">@color/foundation_light_progress_track</item>
        <item name="colorTertiaryFixedDim">@color/foundation_light_outline</item>
        <item name="colorOnTertiaryFixed">@color/foundation_light_on_background</item>
        <item name="colorOnTertiaryFixedVariant">@color/foundation_light_on_background_muted</item>
        <item name="android:colorBackground">@color/foundation_light_background</item>
        <item name="android:windowBackground">@color/foundation_light_background</item>
        <item name="android:textColorHint">@color/hint_text_color</item>
        <item name="android:textColor">@color/text_color_primary</item>
        <item name="android:textColorPrimary">@color/text_color_primary</item>
        <item name="android:textColorSecondary">@color/text_color_secondary</item>
        <item name="android:textColorTertiary">@color/text_color_secondary</item>
        <item name="android:textColorHighlight">?attr/foundationProgressTrack</item>

        <!--
          Foundation type: interface text falls back to the interface typeface, and Material 3's type
          slots are the Foundation's styles (foundation.xml). Keep Light and Dark in step.
        -->
        <item name="android:fontFamily">@font/foundation_interface</item>
        <item name="fontFamily">@font/foundation_interface</item>
        <!-- Redraws inflated text in the interface typeface: Newsreader, then the Chinese or Japanese face -->
        <item name="viewInflaterClass">com.ichi2.anki.common.android.themes.FoundationViewInflater</item>
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.Foundation.ScreenTitle</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.Foundation.ScreenTitle</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.Foundation.ScreenTitle</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.Foundation.ScreenTitle</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.Foundation.PageTitle</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Foundation.DeckName</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Foundation.DeckName</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Foundation.RowTitle</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.Foundation.RowTitle</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Foundation.Lead</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Foundation.Body</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Foundation.Caption</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Foundation.Button</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.Foundation.Label</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.Foundation.Label</item>
        <item name="android:textAppearance">@style/TextAppearance.Foundation.Body</item>
        <item name="android:textAppearanceSmall">@style/TextAppearance.Foundation.Body</item>
        <item name="android:textAppearanceMedium">@style/TextAppearance.Foundation.Lead</item>
        <item name="android:textAppearanceLarge">@style/TextAppearance.Foundation.DeckName</item>
        <item name="android:textAppearanceListItem">@style/TextAppearance.Foundation.Lead</item>
        <item name="android:textAppearanceListItemSmall">@style/TextAppearance.Foundation.Body</item>
        <item name="android:textAppearanceListItemSecondary">@style/TextAppearance.Foundation.Caption</item>
        <!-- Older type slots that AppCompat and Material 2 widgets still read -->
        <item name="textAppearanceHeadline1">@style/TextAppearance.Foundation.ScreenTitle</item>
        <item name="textAppearanceHeadline2">@style/TextAppearance.Foundation.ScreenTitle</item>
        <item name="textAppearanceHeadline3">@style/TextAppearance.Foundation.ScreenTitle</item>
        <item name="textAppearanceHeadline4">@style/TextAppearance.Foundation.PageTitle</item>
        <item name="textAppearanceHeadline5">@style/TextAppearance.Foundation.DeckName</item>
        <item name="textAppearanceHeadline6">@style/TextAppearance.Foundation.DeckName</item>
        <item name="textAppearanceSubtitle1">@style/TextAppearance.Foundation.RowTitle</item>
        <item name="textAppearanceSubtitle2">@style/TextAppearance.Foundation.RowTitle</item>
        <item name="textAppearanceBody1">@style/TextAppearance.Foundation.Lead</item>
        <item name="textAppearanceBody2">@style/TextAppearance.Foundation.Body</item>
        <item name="textAppearanceCaption">@style/TextAppearance.Foundation.Caption</item>
        <item name="textAppearanceButton">@style/TextAppearance.Foundation.Button</item>
        <item name="textAppearanceOverline">@style/TextAppearance.Foundation.Label</item>
        <item name="textAppearanceListItem">@style/TextAppearance.Foundation.Lead</item>
        <item name="textAppearanceListItemSmall">@style/TextAppearance.Foundation.Body</item>
        <item name="textAppearanceListItemSecondary">@style/TextAppearance.Foundation.Caption</item>

        <!-- Foundation shapes and elevation -->
        <item name="shapeCornerSizeExtraSmall">@dimen/foundation_shape_card_sheet</item>
        <item name="shapeCornerSizeSmall">@dimen/foundation_shape_button</item>
        <item name="shapeCornerSizeMedium">@dimen/foundation_shape_button</item>
        <item name="shapeCornerSizeLarge">@dimen/foundation_shape_add_button</item>
        <item name="shapeCornerSizeLargeIncreased">@dimen/foundation_shape_add_button</item>
        <item name="shapeCornerSizeExtraLarge">@dimen/foundation_shape_button</item>
        <item name="shapeCornerSizeExtraLargeIncreased">@dimen/foundation_shape_button</item>
        <item name="shapeCornerSizeExtraExtraLarge">@dimen/foundation_shape_button</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Foundation.CardSheet</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Foundation.Button</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Foundation.Button</item>
        <item name="materialButtonStyle">@style/Widget.Foundation.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Foundation.Button.Outlined</item>
        <item name="materialCardViewStyle">@style/Widget.Foundation.Card</item>
        <item name="floatingActionButtonStyle">@style/Widget.Foundation.AddButton</item>
        <item name="elevationOverlayEnabled">false</item>

        <item name="preferenceCategoryTitleTextColor">?attr/foundationOnBackgroundMuted</item>
        <!-- Navigation drawer theme -->
        <item name="navDrawerItemColor">@color/drawer_item_text</item>
        <item name="navDrawerItemBackground">@drawable/drawer_item_background</item>
        <!-- Menu -->
        <!-- Icons the platform draws: the up arrow, the overflow menu, the search field -->
        <item name="homeAsUpIndicator">@drawable/symbol_arrow_back</item>
        <item name="actionOverflowButtonStyle">@style/Widget.Foundation.OverflowButton</item>
        <item name="searchViewStyle">@style/Widget.Foundation.SearchView</item>
        <item name="actionOverflowMenuStyle">@style/OverflowMenuStyle</item>
        <item name="popupMenuStyle">@style/PopupMenuStyle</item>
        <item name="spinnerStyle">@style/SpinnerStyle</item>
        <!-- Action bar styles: the bar is part of the page -->
        <item name="appBarColor">?attr/foundationBackground</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionModeOverlay">true</item>
        <item name="actionBarTextColor">?attr/foundationOnBackground</item>
        <item name="actionModeBackground">?attr/appBarColor</item>
        <!-- Bottom navigation -->
        <item name="bottomNavIndicatorColor">?attr/foundationProgressTrack</item>
        <item name="bottomNavActiveIconColor">?attr/foundationOnBackground</item>
        <!-- Deck list colors -->
        <item name="selectedRowBackgroundColor">?attr/foundationProgressTrack</item>
        <item name="dynDeckColor">?attr/foundationCountNew</item>
        <!-- Count colors -->
        <item name="newCountColor">?attr/foundationCountNew</item>
        <item name="learnCountColor">?attr/foundationCountLearning</item>
        <item name="reviewCountColor">?attr/foundationCountDue</item>
        <item name="buryCountColor">?attr/foundationOnBackgroundMuted</item>
        <item name="zeroCountColor">?attr/foundationOnBackgroundMuted</item>
        <!-- Study Screen colors: answer buttons are paper, labelled in their answer colour -->
        <item name="againButtonBackground">?attr/foundationBackground</item>
        <item name="hardButtonBackground">?attr/foundationBackground</item>
        <item name="goodButtonBackground">?attr/foundationBackground</item>
        <item name="easyButtonBackground">?attr/foundationBackground</item>
        <item name="topBarColor">?attr/foundationBackground</item>
        <item name="maxTimerColor">?attr/foundationEmphasis</item>
        <!-- the old study screen's Show answer bar and the strip below its answer buttons are paper, like the buttons -->
        <item name="showAnswerTextColor">?attr/foundationOnBackground</item>
        <item name="againButtonTextColor">?attr/foundationAnswerAgain</item>
        <item name="hardButtonTextColor">?attr/foundationAnswerHard</item>
        <item name="goodButtonTextColor">?attr/foundationAnswerGood</item>
        <item name="easyButtonTextColor">?attr/foundationAnswerEasy</item>
        <item name="againTextColor">?attr/foundationAnswerAgain</item>
        <item name="hardTextColor">?attr/foundationAnswerHard</item>
        <item name="goodTextColor">?attr/foundationAnswerGood</item>
        <item name="easyTextColor">?attr/foundationAnswerEasy</item>
        <item name="againBackgroundColor">?attr/foundationBackground</item>
        <item name="hardBackgroundColor">?attr/foundationBackground</item>
        <item name="goodBackgroundColor">?attr/foundationBackground</item>
        <item name="easyBackgroundColor">?attr/foundationBackground</item>
        <item name="againIconColor">?againTextColor</item>
        <item name="hardIconColor">?hardTextColor</item>
        <item name="goodIconColor">?goodTextColor</item>
        <item name="easyIconColor">?easyTextColor</item>
        <!-- Study Screen button drawables -->
        <item name="showAnswerButtonBackground">?attr/foundationPrimary</item>
        <item name="showAnswerColor">?attr/foundationBackground</item>
        <item name="answerButtonRef">@drawable/footer_button</item>
        <item name="answerButtonRippleRef">@drawable/footer_button_ripple</item>
        <!-- Card Browser Colors -->
        <item name="cardBrowserDivider">?attr/foundationOutline</item>
        <!-- Browser colors -->
        <item name="suspendedColor">#FFFFB2</item>
        <item name="buriedColor">#FFCE7C</item>
        <item name="markedColor">#D9B2E9</item>
        <!-- Note editor colors -->
        <item name="duplicateColor">#fcc</item>
        <item name="toolbarBackgroundColor">?attr/foundationBackground</item>
        <item name="buttonShadowColor">#FFAAAAAA</item>
        <item name="buttonRippleColor">#595959</item>
        <item name="buttonForegroundColor">?attr/foundationProgressTrack</item>
        <!-- FAB: the add button, the one primary action -->
        <item name="fabNormalColor">?attr/foundationPrimary</item>
        <item name="fabPressedColor">?attr/foundationPrimary</item>
        <!-- Dialog styles -->
        <item name="android:listPreferredItemHeight">56dip</item>
        <item name="dialogCornerRadius">@dimen/dialog_corner_radius</item>
        <item name="android:dialogCornerRadius" tools:targetApi="p">@dimen/dialog_corner_radius</item>
        <item name="textAllCaps">false</item>
        <item name="popupBackgroundColor">?attr/foundationBackground</item>
        <item name="overflowAndPopupMenuIconColor">@color/overflow_menu_icon_color</item>
        <!-- StatusBar -->
        <item name="android:statusBarColor">@color/foundation_light_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Navbar -->
        <item name="android:navigationBarColor">@color/foundation_light_background</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <!-- Widget styles -->
        <item name="switchPreferenceCompatStyle">@style/Preference.SwitchPreferenceCompat.Material3</item>
        <item name="sliderStyle">@style/SliderStyle</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.AnkiDroid</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.AnkiDroid.AlertDialog</item>

        <!-- ProgressDialog-->
        <item name="dialogBackground">?attr/colorSurface</item>

        <item name="tabStyle">@style/Widget.MaterialComponents.TabLayout</item>

        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.App.BottomSheetDialog</item>


        <item name="clozeColor">?attr/foundationCountNew</item>

        <item name="incrementerButtonBackground">?attr/foundationPrimary</item>

        <!-- Reminder troubleshooting - check contrast before changing -->
        <item name="reminderTroubleshootingOk">?attr/foundationCountDue</item>
        <item name="reminderTroubleshootingWarning">?attr/foundationEmphasis</item>


        <item name="badgeErrorColor">?attr/foundationEmphasis</item>
        <item name="badgeWarningColor">?attr/foundationEmphasis</item>
        <!-- Hairlines instead of filled cards -->
        <item name="widgetStrokeWidth">@dimen/foundation_shape_hairline</item>
        <item name="widgetStrokeColor">?attr/foundationOutline</item>
        <item name="studyScreenElevation">@dimen/foundation_elevation_flat</item>
        <item name="whiteboardToolbarCardStyle">?attr/materialCardViewStyle</item>
    </style>

    <style name="Theme_Light" parent="Base.Theme.Light"/>
</resources>
