<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="UnusedResources,DuplicateCrowdInStrings">

    <!-- Action bar. Currently all action bar text is white in every theme. -->
    <style name="ActionBarStyle" parent="Base.ThemeOverlay.AppCompat.ActionBar">
        <!-- Colors: hamburger, title text, overflow icon -->
        <item name="android:textColorPrimary">?attr/actionBarTextColor</item>
        <!-- Colors: subtitle text -->
        <item name="android:textColorSecondary">?attr/actionBarTextColor</item>
        <!-- Overflow menu style -->
        <item name="popupTheme">@style/ActionBar.Popup</item>
    </style>

    <!-- For all other action bar popups like overflow menu (except spinner dropdown in Lollipop). -->
    <style name="ActionBar.Popup" parent="Base.ThemeOverlay.AppCompat.ActionBar">
        <item name="android:drawSelectorOnTop">false</item>
        <item name="android:textColorPrimary">?android:attr/textColor</item>
        <item name="android:textColorSecondary">?android:attr/textColor</item>
        <item name="android:colorBackground">?attr/popupBackgroundColor</item>
    </style>

    <style name="OverflowMenuStyle" parent="Widget.Material3.PopupMenu.Overflow">
        <item name="android:popupBackground">@drawable/bg_popup</item>
    </style>

    <style name="PopupMenuStyle" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup</item>
    </style>

    <style name="SpinnerStyle" parent="Widget.AppCompat.Spinner">
        <item name="android:popupBackground">@drawable/bg_popup</item>
    </style>

    <style name="ThemeOverlay.AnkiDroid.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="dialogCornerRadius">@dimen/foundation_shape_dialog</item>
        <item name="materialAlertDialogBodyTextStyle">@style/AnkiDroid.AlertDialog.Body.Text</item>
        <item name="android:windowBackground">@drawable/material_dialog_background</item>
    </style>

    <style name="AnkiDroid.AlertDialog.Body.Text" parent="MaterialAlertDialog.Material3.Body.Text">
        <!-- Keep dialog body text consistent with the primary text color -->
        <item name="android:textColor">?android:attr/textColor</item>
    </style>

    <style name="ThemeOverlay.App.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="android:navigationBarColor" tools:ignore="NewApi">@android:color/transparent</item>
    </style>

    <!-- Foundation shapes: Material 3's corner scale -->
    <style name="ShapeAppearance.Foundation.Small" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/foundation_shape_small</item>
    </style>

    <style name="ShapeAppearance.Foundation.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/foundation_shape_dialog</item>
    </style>

    <style name="ShapeAppearance.Foundation.CardSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/foundation_shape_card_sheet</item>
    </style>

    <style name="ShapeAppearance.Foundation.Button" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/foundation_shape_button</item>
    </style>

    <style name="ShapeAppearance.Foundation.AddButton" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/foundation_shape_add_button</item>
    </style>

    <style name="Widget.Foundation.Button" parent="Widget.Material3.Button">
        <item name="shapeAppearance">@style/ShapeAppearance.Foundation.Button</item>
        <item name="elevation">@dimen/foundation_elevation_flat</item>
    </style>

    <style name="Widget.Foundation.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="shapeAppearance">@style/ShapeAppearance.Foundation.Button</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="strokeWidth">@dimen/foundation_shape_hairline</item>
    </style>

    <!-- Cards are tonal: a filled container, no outline and no shadow -->
    <style name="Widget.Foundation.Card" parent="Widget.Material3.CardView.Filled">
        <item name="shapeAppearance">@style/ShapeAppearance.Foundation.CardSheet</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLow</item>
        <item name="cardElevation">@dimen/foundation_elevation_flat</item>
    </style>

    <!-- The add button: Material 3's primary-container FAB, the only surface with a shadow -->
    <style name="Widget.Foundation.AddButton" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="shapeAppearance">@style/ShapeAppearance.Foundation.AddButton</item>
        <item name="backgroundTint">?attr/colorPrimaryContainer</item>
        <item name="tint">?attr/colorOnPrimaryContainer</item>
        <item name="elevation">@dimen/foundation_elevation_add_button</item>
    </style>

    <!-- The overflow menu's icon, drawn from Material Symbols like every interface icon -->
    <style name="Widget.Foundation.OverflowButton" parent="Widget.AppCompat.ActionButton.Overflow">
        <item name="android:src">@drawable/symbol_more_vert</item>
    </style>

    <!-- The search field's icons, drawn from Material Symbols like every interface icon -->
    <style name="Widget.Foundation.SearchView" parent="Widget.AppCompat.SearchView">
        <item name="searchIcon">@drawable/symbol_search</item>
        <item name="searchHintIcon">@drawable/symbol_search</item>
        <item name="closeIcon">@drawable/symbol_close</item>
        <item name="goIcon">@drawable/symbol_arrow_forward</item>
        <item name="voiceIcon">@drawable/symbol_mic</item>
    </style>
</resources>
