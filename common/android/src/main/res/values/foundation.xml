<!--
  The Foundation: the app-wide base of the chosen Direction (Quiet paper) that every Native Surface
  inherits. Every value here is copied from docs/redesign/quiet-paper.values.json, the single source;
  FoundationTest fails if one drifts from it.

  XML reads the colour roles as theme attributes (?attr/foundationPrimary); each theme in
  theme_light.xml, theme_dark.xml and theme_black.xml points them at the colours below, and maps
  the Material 3 colour roles onto them. Compose reads the same attributes through AnkiDroidTheme
  (MaterialTheme.foundation). Shapes and spacing are plain dimensions read by both; the type scale is a
  set of TextAppearance styles read by both.
-->
<resources>
    <!-- Colour roles, as theme attributes -->
    <attr name="foundationBackground" format="color" />
    <attr name="foundationOnBackground" format="color" />
    <attr name="foundationOnBackgroundMuted" format="color" />
    <attr name="foundationOutline" format="color" />
    <attr name="foundationPrimary" format="color" />
    <attr name="foundationOnPrimary" format="color" />
    <attr name="foundationEmphasis" format="color" />
    <attr name="foundationCountNew" format="color" />
    <attr name="foundationCountLearning" format="color" />
    <attr name="foundationCountDue" format="color" />
    <attr name="foundationAnswerAgain" format="color" />
    <attr name="foundationAnswerHard" format="color" />
    <attr name="foundationAnswerGood" format="color" />
    <attr name="foundationAnswerEasy" format="color" />
    <attr name="foundationProgressTrack" format="color" />
    <attr name="foundationProgressFill" format="color" />

    <!-- How Compose reads the colour roles (Foundation.kt) -->
    <declare-styleable name="Foundation">
        <attr name="foundationBackground" />
        <attr name="foundationOnBackground" />
        <attr name="foundationOnBackgroundMuted" />
        <attr name="foundationOutline" />
        <attr name="foundationPrimary" />
        <attr name="foundationOnPrimary" />
        <attr name="foundationEmphasis" />
        <attr name="foundationCountNew" />
        <attr name="foundationCountLearning" />
        <attr name="foundationCountDue" />
        <attr name="foundationAnswerAgain" />
        <attr name="foundationAnswerHard" />
        <attr name="foundationAnswerGood" />
        <attr name="foundationAnswerEasy" />
        <attr name="foundationProgressTrack" />
        <attr name="foundationProgressFill" />
    </declare-styleable>

    <!-- Light: 白纸 Plain paper, chosen by the owner on 2026-11-18 (it replaced the cream palette) -->
    <color name="foundation_light_background">#FAFAF8</color>
    <color name="foundation_light_on_background">#1F1E1C</color>
    <color name="foundation_light_on_background_muted">#625F59</color>
    <color name="foundation_light_outline">#E2E0DB</color>
    <color name="foundation_light_primary">#A63D25</color>
    <color name="foundation_light_on_primary">#FFFFFF</color>
    <color name="foundation_light_emphasis">#A63D25</color>
    <color name="foundation_light_count_new">#2F4A6B</color>
    <color name="foundation_light_count_learning">#A63D25</color>
    <color name="foundation_light_count_due">#3E5B34</color>
    <color name="foundation_light_answer_again">#A63D25</color>
    <color name="foundation_light_answer_hard">#8A5E10</color>
    <color name="foundation_light_answer_good">#3E5B34</color>
    <color name="foundation_light_answer_easy">#2F4A6B</color>
    <color name="foundation_light_progress_track">#E6E4DF</color>
    <color name="foundation_light_progress_fill">#1F1E1C</color>

    <!-- Dark -->
    <color name="foundation_dark_background">#1C1A17</color>
    <color name="foundation_dark_on_background">#ECE5D8</color>
    <color name="foundation_dark_on_background_muted">#A9A090</color>
    <color name="foundation_dark_outline">#3B362E</color>
    <color name="foundation_dark_primary">#C0492A</color>
    <color name="foundation_dark_on_primary">#FFF7EF</color>
    <color name="foundation_dark_emphasis">#E67A5C</color>
    <color name="foundation_dark_count_new">#93B4DC</color>
    <color name="foundation_dark_count_learning">#EE8E72</color>
    <color name="foundation_dark_count_due">#A3C592</color>
    <color name="foundation_dark_answer_again">#E0694B</color>
    <color name="foundation_dark_answer_hard">#D6A24A</color>
    <color name="foundation_dark_answer_good">#8FB57F</color>
    <color name="foundation_dark_answer_easy">#86A8D4</color>
    <color name="foundation_dark_progress_track">#3B362E</color>
    <color name="foundation_dark_progress_fill">#ECE5D8</color>

    <!-- Black: Dark on true black. Only the background, outline and progress track differ. -->
    <color name="foundation_black_background">#000000</color>
    <color name="foundation_black_outline">#2E2A24</color>
    <color name="foundation_black_progress_track">#2E2A24</color>

    <!-- Shape: corner radii and rule widths. The icon button's corner is full (a circle). -->
    <dimen name="foundation_shape_card_sheet">4dp</dimen>
    <dimen name="foundation_shape_button">6dp</dimen>
    <dimen name="foundation_shape_add_button">16dp</dimen>
    <dimen name="foundation_shape_hairline">1dp</dimen>
    <dimen name="foundation_shape_current_tab_rule">2dp</dimen>
    <dimen name="foundation_shape_answer_rule">3dp</dimen>

    <!-- Spacing: the scale, then named sizes -->
    <dimen name="foundation_space_4">4dp</dimen>
    <dimen name="foundation_space_8">8dp</dimen>
    <dimen name="foundation_space_12">12dp</dimen>
    <dimen name="foundation_space_16">16dp</dimen>
    <dimen name="foundation_space_20">20dp</dimen>
    <dimen name="foundation_space_24">24dp</dimen>
    <dimen name="foundation_space_32">32dp</dimen>
    <dimen name="foundation_spacing_screen_margin">20dp</dimen>
    <dimen name="foundation_spacing_study_margin">16dp</dimen>
    <dimen name="foundation_spacing_touch_target">48dp</dimen>
    <dimen name="foundation_spacing_deck_row">58dp</dimen>
    <dimen name="foundation_spacing_deck_row_nested">48dp</dimen>
    <dimen name="foundation_spacing_count_column">46dp</dimen>
    <dimen name="foundation_spacing_primary_button">56dp</dimen>
    <dimen name="foundation_spacing_answer_button">66dp</dimen>
    <dimen name="foundation_spacing_add_button">56dp</dimen>
    <dimen name="foundation_spacing_bottom_bar">78dp</dimen>
    <dimen name="foundation_spacing_list_row">64dp</dimen>
    <dimen name="foundation_spacing_secondary_button">52dp</dimen>
    <dimen name="foundation_spacing_page_mark">56dp</dimen>
    <dimen name="foundation_spacing_empty_mark">96dp</dimen>

    <!--
      Elevation: surfaces are flat and separated by hairlines. Nothing casts a shadow except the
      add button, whose shadow is the primary colour at 55% opacity.
    -->
    <dimen name="foundation_elevation_flat">0dp</dimen>
    <dimen name="foundation_elevation_add_button">8dp</dimen>
    <item name="foundation_elevation_add_button_shadow_alpha" format="float" type="dimen">0.55</item>

    <!--
      Type: the type scale. Each role is a TextAppearance; Compose reads the same styles
      (MaterialTheme.foundation.type). Hierarchy is carried by size and weight only: no style is
      italic, set in capitals or letter-spaced. The line height is the size times the role's
      lineHeight, roomy enough for Chinese and Japanese. Weights 600 and above are also marked bold,
      the only weight Android 7 and 8 can show.

      Every style sets the interface typeface (@font/foundation_interface). On Android 10 and later,
      text inflated from a layout is redrawn in InterfaceTypeface.kt's fallback chain at the same weight.
    -->
    <!--
      How Compose reads a type role (Foundation.kt). Android before 9 lacks android:textFontWeight and
      android:lineHeight, so each role is Base.TextAppearance.Foundation.<Role> here and
      values-v28/foundation.xml adds those two attributes to TextAppearance.Foundation.<Role>. Compose
      reads the weight from foundationTextWeight and the line height from lineHeight, present on every
      version.
    -->
    <attr name="foundationTextWeight" format="integer" />
    <declare-styleable name="FoundationTextAppearance">
        <attr name="android:textSize" />
        <attr name="foundationTextWeight" />
        <attr name="lineHeight" />
        <attr name="android:fontFeatureSettings" />
    </declare-styleable>

    <style name="TextAppearance.Foundation" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/foundation_interface</item>
        <item name="fontFamily">@font/foundation_interface</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
    </style>

    <!-- The title of a top-level screen -->
    <style name="Base.TextAppearance.Foundation.ScreenTitle" parent="TextAppearance.Foundation">
        <item name="android:textSize">38sp</item>
        <item name="foundationTextWeight">500</item>
        <item name="lineHeight">43.7sp</item>
    </style>
    <style name="TextAppearance.Foundation.ScreenTitle" parent="Base.TextAppearance.Foundation.ScreenTitle" />

    <!-- The heading of the finished screen and of an empty screen -->
    <style name="Base.TextAppearance.Foundation.PageTitle" parent="TextAppearance.Foundation">
        <item name="android:textSize">30sp</item>
        <item name="foundationTextWeight">500</item>
        <item name="lineHeight">36sp</item>
    </style>
    <style name="TextAppearance.Foundation.PageTitle" parent="Base.TextAppearance.Foundation.PageTitle" />

    <!-- A top-level Deck in the deck list -->
    <style name="Base.TextAppearance.Foundation.DeckName" parent="TextAppearance.Foundation">
        <item name="android:textSize">20sp</item>
        <item name="foundationTextWeight">500</item>
        <item name="lineHeight">26sp</item>
    </style>
    <style name="TextAppearance.Foundation.DeckName" parent="Base.TextAppearance.Foundation.DeckName" />

    <!-- A Deck inside another Deck -->
    <style name="Base.TextAppearance.Foundation.DeckNameNested" parent="TextAppearance.Foundation">
        <item name="android:textSize">17.5sp</item>
        <item name="foundationTextWeight">400</item>
        <item name="lineHeight">22.75sp</item>
    </style>
    <style name="TextAppearance.Foundation.DeckNameNested" parent="Base.TextAppearance.Foundation.DeckNameNested" />

    <!-- The line that says what is due today -->
    <style name="Base.TextAppearance.Foundation.Summary" parent="TextAppearance.Foundation">
        <item name="android:textSize">18sp</item>
        <item name="foundationTextWeight">500</item>
        <item name="lineHeight">25.2sp</item>
    </style>
    <style name="TextAppearance.Foundation.Summary" parent="Base.TextAppearance.Foundation.Summary" />

    <!-- A new, learning or due count; a zero count uses weight 400 -->
    <style name="Base.TextAppearance.Foundation.Count" parent="TextAppearance.Foundation">
        <item name="android:textSize">17sp</item>
        <item name="foundationTextWeight">600</item>
        <item name="android:textStyle">bold</item>
        <item name="lineHeight">20.4sp</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
    <style name="TextAppearance.Foundation.Count" parent="Base.TextAppearance.Foundation.Count" />

    <!-- The Deck name on the study screen -->
    <style name="Base.TextAppearance.Foundation.StudyTitle" parent="TextAppearance.Foundation">
        <item name="android:textSize">17sp</item>
        <item name="foundationTextWeight">500</item>
        <item name="lineHeight">23.8sp</item>
    </style>
    <style name="TextAppearance.Foundation.StudyTitle" parent="Base.TextAppearance.Foundation.StudyTitle" />

    <!-- The label of a primary button -->
    <style name="Base.TextAppearance.Foundation.Button" parent="TextAppearance.Foundation">
        <item name="android:textSize">17sp</item>
        <item name="foundationTextWeight">500</item>
        <item name="lineHeight">23.8sp</item>
    </style>
    <style name="TextAppearance.Foundation.Button" parent="Base.TextAppearance.Foundation.Button" />

    <!-- The title of a row in a list of actions or destinations (More, the finished screen) -->
    <style name="Base.TextAppearance.Foundation.RowTitle" parent="TextAppearance.Foundation">
        <item name="android:textSize">17sp</item>
        <item name="foundationTextWeight">500</item>
        <item name="lineHeight">23.8sp</item>
    </style>
    <style name="TextAppearance.Foundation.RowTitle" parent="Base.TextAppearance.Foundation.RowTitle" />

    <!-- The explanation under a page title -->
    <style name="Base.TextAppearance.Foundation.Lead" parent="TextAppearance.Foundation">
        <item name="android:textSize">16sp</item>
        <item name="foundationTextWeight">400</item>
        <item name="lineHeight">24.8sp</item>
    </style>
    <style name="TextAppearance.Foundation.Lead" parent="Base.TextAppearance.Foundation.Lead" />

    <!-- Again, Hard, Good and Easy -->
    <style name="Base.TextAppearance.Foundation.Answer" parent="TextAppearance.Foundation">
        <item name="android:textSize">16.5sp</item>
        <item name="foundationTextWeight">600</item>
        <item name="android:textStyle">bold</item>
        <item name="lineHeight">23.1sp</item>
    </style>
    <style name="TextAppearance.Foundation.Answer" parent="Base.TextAppearance.Foundation.Answer" />

    <!-- Ordinary interface text -->
    <style name="Base.TextAppearance.Foundation.Body" parent="TextAppearance.Foundation">
        <item name="android:textSize">15sp</item>
        <item name="foundationTextWeight">400</item>
        <item name="lineHeight">21sp</item>
    </style>
    <style name="TextAppearance.Foundation.Body" parent="Base.TextAppearance.Foundation.Body" />

    <!-- Remaining counts on the study screen -->
    <style name="Base.TextAppearance.Foundation.StudyCount" parent="TextAppearance.Foundation">
        <item name="android:textSize">14.5sp</item>
        <item name="foundationTextWeight">600</item>
        <item name="android:textStyle">bold</item>
        <item name="lineHeight">17.4sp</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
    <style name="TextAppearance.Foundation.StudyCount" parent="Base.TextAppearance.Foundation.StudyCount" />

    <!-- Dates and secondary lines -->
    <style name="Base.TextAppearance.Foundation.Caption" parent="TextAppearance.Foundation">
        <item name="android:textSize">13sp</item>
        <item name="foundationTextWeight">400</item>
        <item name="lineHeight">18.2sp</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>
    <style name="TextAppearance.Foundation.Caption" parent="Base.TextAppearance.Foundation.Caption" />

    <!-- Column headers, bottom bar labels, answer times; the current bottom bar label uses weight 600 -->
    <style name="Base.TextAppearance.Foundation.Label" parent="TextAppearance.Foundation">
        <item name="android:textSize">12sp</item>
        <item name="foundationTextWeight">400</item>
        <item name="lineHeight">16.8sp</item>
    </style>
    <style name="TextAppearance.Foundation.Label" parent="Base.TextAppearance.Foundation.Label" />

    <!-- The current tab's label in the bottom bar: Label at weight 600 -->
    <style name="Base.TextAppearance.Foundation.Label.Current" parent="TextAppearance.Foundation.Label">
        <item name="foundationTextWeight">600</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.Foundation.Label.Current" parent="Base.TextAppearance.Foundation.Label.Current" />
</resources>
