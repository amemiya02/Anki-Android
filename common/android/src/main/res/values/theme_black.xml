<!--
  Black: Dark on true black, for OLED screens. The surfaces and the hairlines step up from black;
  every other role follows Dark, so only the colours that differ are replaced here.
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="DuplicateCrowdInStrings">
    <style name="Base.Theme.Dark.Black" parent="Theme_Dark">
        <item name="foundationBackground">@color/foundation_black_background</item>
        <item name="foundationOutline">@color/foundation_black_outline</item>
        <item name="foundationProgressTrack">@color/foundation_black_progress_track</item>

        <item name="colorSurface">@color/scheme_black_surface</item>
        <item name="colorOutlineVariant">@color/scheme_black_outline_variant</item>
        <item name="colorSurfaceContainerLowest">@color/scheme_black_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/scheme_black_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/scheme_black_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/scheme_black_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/scheme_black_surface_container_highest</item>
        <item name="colorSurfaceDim">@color/scheme_black_surface_dim</item>
        <item name="colorSurfaceBright">@color/scheme_black_surface_bright</item>

        <item name="android:colorBackground">@color/foundation_black_background</item>
        <item name="android:windowBackground">@color/foundation_black_background</item>
        <item name="android:statusBarColor">@color/foundation_black_background</item>
        <item name="android:navigationBarColor">@color/foundation_black_background</item>
    </style>

    <style name="Theme_Dark.Black" parent="Base.Theme.Dark.Black"/>
</resources>
