<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Divider removed because the above tab layout already has one -->
    <PreferenceCategory android:title="@string/answer_buttons"
        app:allowDividerAbove="false">
        <com.ichi2.preferences.ReviewerControlPreference
            android:key="@string/show_answer_command_key"
            android:title="@string/show_answer"
            android:icon="@drawable/symbol_exclamation"
            app:cardSide="question"
            />
        <com.ichi2.preferences.ReviewerControlPreference
            android:key="@string/answer_again_command_key"
            tools:title="Answer again"
            android:icon="@drawable/symbol_close_again"
            app:cardSide="answer"
            />
        <com.ichi2.preferences.ReviewerControlPreference
            android:key="@string/answer_hard_command_key"
            tools:title="Answer hard"
            android:icon="@drawable/symbol_check_small_hard"
            app:cardSide="answer"
            />
        <com.ichi2.preferences.ReviewerControlPreference
            android:key="@string/answer_good_command_key"
            tools:title="Answer good"
            android:icon="@drawable/symbol_check_good"
            app:cardSide="answer"
            />
        <!-- 'Answer easy' is not provided by the backend -->
        <com.ichi2.preferences.ReviewerControlPreference
            android:key="@string/answer_easy_command_key"
            android:title="@string/answer_easy"
            android:icon="@drawable/symbol_done_all_easy"
            app:cardSide="answer"
            />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/filter_by_flags">
        <com.ichi2.preferences.ReviewerControlPreference
            android:key="@string/flag_red_command_key"
