        <com.ichi2.preferences.ReviewerControlPreference
            android:key="@string/toggle_eraser_command_key"
            android:title="@string/gesture_toggle_eraser"
            android:icon="@drawable/symbol_ink_eraser"
            />
        <com.ichi2.preferences.ReviewerControlPreference
            android:key="@string/clear_whiteboard_command_key"
            android:title="@string/clear_whiteboard"
            android:icon="@drawable/symbol_delete_sweep"
            />
        <com.ichi2.preferences.ReviewerControlPreference
            android:key="@string/change_whiteboard_pen_color_command_key"
            android:title="@string/title_whiteboard_editor"
            android:icon="@drawable/symbol_palette"
            />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/misc">
        <com.ichi2.preferences.ReviewerControlPreference
            android:key="@string/undo_command_key"
            android:title="@string/undo"
            android:icon="@drawable/symbol_undo"
            />
        <com.ichi2.preferences.ReviewerControlPreference
            android:key="@string/redo_command_key"
            android:title="@string/redo"
            android:icon="@drawable/symbol_redo"
            />
        <com.ichi2.preferences.ReviewerControlPreference
