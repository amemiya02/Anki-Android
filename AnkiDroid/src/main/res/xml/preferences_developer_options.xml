<!--
~ Some strings aren't translated because these preferences are aimed
~ at developers, who are assumed to speak English.
-->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/pref_cat_dev_options"
    android:key="@string/pref_developer_options_screen_key">
    <SwitchPreferenceCompat
        android:title="@string/dev_options_enabled_pref"
        android:key="@string/developer_options_enabled_by_user_key"
        android:defaultValue="true"/>
    <SwitchPreferenceCompat
        android:defaultValue="false"
        android:key="@string/html_javascript_debugging_key"
        android:summary="@string/settings_dev_web_debug_summary"
        android:title="@string/settings_dev_web_debug"/>
    <Preference
        android:title="@string/settings_dev_test_crash"
        android:summary="@string/settings_dev_test_crash_summary"
        android:key="@string/pref_trigger_crash_key"/>
    <Preference
        android:title="@string/settings_dev_lock_database"
        android:summary="@string/settings_dev_lock_database_summary"
        android:key="@string/pref_lock_database_key"/>
    <Preference
        android:title="@string/settings_dev_corrupt_fsrs"
        android:summary="@string/settings_dev_corrupt_fsrs_summary"
        android:key="@string/pref_corrupt_fsrs_params"/>
    <Preference
        android:title="@string/settings_dev_set_database_path"
        android:summary="@string/settings_dev_set_database_path_summary"
        android:key="@string/pref_set_database_path_debug_key"/>
    <Preference
        android:title="@string/settings_dev_tts_voices"
        android:summary="@string/settings_dev_tts_voices_summary"
        android:key="@string/dev_open_tts_voices"/>
    <PreferenceCategory
        android:title="@string/settings_dev_test_notes"
        >
        <com.ichi2.preferences.IncrementerNumberRangePreferenceCompat
            android:key="@string/pref_fill_default_deck_number_key"
            android:title="@string/settings_dev_note_count"
            app:useSimpleSummaryProvider="true"
            android:defaultValue="200"
            app:min="1"
            />
        <Preference
            android:key="@string/pref_fill_default_deck_key"
            android:title="@string/settings_dev_create_notes"
            />
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/settings_dev_test_media"
        >
        <com.ichi2.preferences.IncrementerNumberRangePreferenceCompat
            android:key="@string/pref_fill_collection_number_file_key"
            android:title="@string/settings_dev_file_count"
            app:useSimpleSummaryProvider="true"
            android:defaultValue="20"
            app:min="1"
            />
        <com.ichi2.preferences.IncrementerNumberRangePreferenceCompat
            android:key="@string/pref_fill_collection_size_file_key"
            android:title="@string/settings_dev_file_size"
            app:useSimpleSummaryProvider="true"
            android:defaultValue="1000000"
            app:min="1"
            />
        <Preference
            android:key="@string/pref_fill_collection_key"
            android:title="@string/settings_dev_create_files"
            />
    </PreferenceCategory>

    <com.ichi2.anki.preferences.ExtendedPreferenceCategory
        android:key="@string/pref_cat_wip_key"
        android:title="@string/settings_dev_in_progress"
        android:summary="@string/settings_dev_in_progress_summary">

        <SwitchPreferenceCompat
            android:title="@string/settings_dev_reminders"
            android:key="@string/pref_new_review_reminders"
            android:defaultValue="false"/>
        <SwitchPreferenceCompat
            android:title="@string/settings_dev_profiles"
            android:key="@string/pref_enable_switch_profile_key"
            android:defaultValue="false"/>
    </com.ichi2.anki.preferences.ExtendedPreferenceCategory>
</PreferenceScreen>