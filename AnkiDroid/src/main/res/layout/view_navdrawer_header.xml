<!-- Hayaki's mark on the page, in place of the old look's banner -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/foundation_spacing_screen_margin"
    android:paddingTop="@dimen/foundation_space_24"
    android:paddingBottom="@dimen/foundation_space_8">
    <ImageView
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="start"
        android:importantForAccessibility="no"
        app:srcCompat="@drawable/hayaki_mark" />
</FrameLayout>
