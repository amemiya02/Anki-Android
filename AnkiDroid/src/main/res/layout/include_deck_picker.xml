<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/background"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:id="@+id/deckpicker_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical" >

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/pull_to_sync_wrapper"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- The right-click menu anchors to this frame -->
            <FrameLayout
                android:id="@+id/deck_picker_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- The deck list, drawn by Compose (DeckListScreen) -->
                <androidx.compose.ui.platform.ComposeView
                    android:id="@+id/deck_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>

    <include layout="@layout/include_anki_progress"/>
    <include
        android:id="@+id/floating_action_button"
        layout="@layout/include_floating_add_button"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
