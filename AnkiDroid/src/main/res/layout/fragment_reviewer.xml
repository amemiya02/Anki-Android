<?xml version="1.0" encoding="utf-8"?>

<androidx.coordinatorlayout.widget.CoordinatorLayout  xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/foundationBackground"
    android:fitsSystemWindows="true"
    android:focusableInTouchMode="true"
    android:defaultFocusHighlightEnabled="false"
    tools:context=".ui.windows.reviewer.ReviewerFragment">

    <LinearLayout
        android:id="@+id/main_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:clipChildren="false">

        <!-- The study bar: back, the Deck path with the counts and the estimate, undo and the
             menu, then the progress line. It moves to the bottom with the toolbar position. -->
        <LinearLayout
            android:id="@+id/study_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/tools_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?actionBarSize"
            android:gravity="center_vertical"
            android:paddingBottom="6dp"
            android:layout_marginHorizontal="4dp"
            >

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/back_button"
                style="?actionButtonStyle"
                android:layout_width="?minTouchTargetSize"
                android:layout_height="?minTouchTargetSize"
                android:layout_marginStart="4dp"
                android:contentDescription="@string/abc_action_bar_up_description"
                android:src="?attr/homeAsUpIndicator"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/study_bar_titles"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toEndOf="@id/back_button"
                app:layout_constraintEnd_toStartOf="@id/timer"
                app:layout_constraintBottom_toBottomOf="parent"
                />

            <!-- The answer timer: a quiet caption at the end of the bar, so the bar keeps its
                 height whether or not the Deck shows the timer -->
            <com.ichi2.anki.ui.windows.reviewer.AnswerTimerView
                android:id="@+id/timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:textAppearance="@style/TextAppearance.Foundation.Caption"
                android:fontFeatureSettings="tnum"
                app:layout_constraintEnd_toStartOf="@id/reviewer_menu_view"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:visibility="gone"
                tools:visibility="visible"
                />

            <com.ichi2.anki.preferences.reviewer.ReviewerMenuView
                android:id="@+id/reviewer_menu_view"
                android:theme="@style/ThemeOverlay.Foundation.StudyBarMenu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constrainedWidth="true"
                app:layout_constraintWidth_max="240dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/study_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/web_view_container"
            style="@style/CardView.ViewerStyle"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="14dp"
            android:layout_marginHorizontal="@dimen/foundation_spacing_study_margin"
            app:cardCornerRadius="@dimen/foundation_shape_card_sheet"
            app:cardElevation="0dp">

            <com.ichi2.anki.cardviewer.TypeAnswerWebViewLayout
                android:id="@+id/web_view_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                tools:backgroundTint="@color/white" />

            <LinearLayout
                android:id="@+id/card_indicators"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="6dp"
                >

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/flag_icon"
                    android:layout_width="@dimen/reviewer_mark_flag"
                    android:layout_height="@dimen/reviewer_mark_flag"
                    tools:srcCompat="@drawable/symbol_flag_red"
                    android:layout_marginEnd="2dp"
                    android:visibility="gone"
                    tools:visibility="visible"
                    />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/mark_icon"
                    app:tint="?attr/foundationEmphasis"
                    android:layout_width="@dimen/reviewer_mark_flag"
                    android:layout_height="@dimen/reviewer_mark_flag"
                    app:srcCompat="@drawable/symbol_star"
                    android:visibility="gone"
                    tools:visibility="visible"
                    />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>

                <com.ichi2.anki.ui.windows.reviewer.AnswerFeedbackView
                    android:id="@+id/answer_feedback"
                    android:layout_width="@dimen/reviewer_mark_flag"
                    android:layout_height="@dimen/reviewer_mark_flag"
                    android:visibility="gone"
                    tools:visibility="visible"
                    tools:srcCompat="@drawable/symbol_check_good"
                    />
            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- The elevation should be higher than the one used by the WebView
             container, so the voice recording button can be dragged above it -->
        <LinearLayout
            android:id="@+id/bottom_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:elevation="1dp"
            android:clipChildren="false"
            android:showDividers="middle|beginning|end"
            android:divider="@drawable/vertical_spacer_8dp"
            android:layout_marginHorizontal="@dimen/foundation_spacing_study_margin">

            <!-- Use the same card style of the WebView -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/type_answer_container"
                style="@style/CardView.ViewerStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/foundation_shape_card_sheet"
                app:cardElevation="0dp"
                android:visibility="gone"
                tools:visibility="visible">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="4dp"
                    android:hint="@string/type_answer_hint"
                    android:textColorHint="?attr/foundationOnBackgroundMuted"
                    app:hintTextColor="?attr/foundationOnBackgroundMuted"
                    app:hintTextAppearance="@style/TextAppearance.Foundation.Caption"
                    app:boxBackgroundMode="filled"
                    app:boxBackgroundColor="@android:color/transparent"
                    app:boxStrokeWidth="0dp"
                    app:boxStrokeWidthFocused="0dp"
                    app:endIconMode="clear_text"
                    app:endIconTint="?attr/foundationOnBackgroundMuted"
                    app:endIconDrawable="@drawable/symbol_close">

                    <com.ichi2.ui.TypeAnswerEditText
                        android:id="@+id/type_answer_edit_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Foundation.Lead"
                        android:textColor="?attr/foundationOnBackground"
                        android:imeOptions="actionDone"
                        android:inputType="text|textNoSuggestions"
                        />
                </com.google.android.material.textfield.TextInputLayout>
            </com.google.android.material.card.MaterialCardView>

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/check_pronunciation_container"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:clipChildren="false"
                android:layout_gravity="center_horizontal"
                android:elevation="2dp"
                android:visibility="gone"
                tools:layout="@layout/fragment_check_pronunciation" />

            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/answer_area"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

        </LinearLayout>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
