<LinearLayout android:id="@+id/audioView"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:keepScreenOn="false"
    tools:context=".multimedia.audio.AudioRecordingController">

    <TextView
        android:id="@+id/audio_time_track"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="12dp"
        android:textColor="?attr/foundationOnBackground"
        android:text="00:00.00"
        android:textAppearance="@style/TextAppearance.Foundation.PageTitle"
        tools:ignore="HardcodedText" />

    <LinearLayout
        android:id="@+id/record_buttons_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.ichi2.anki.multimedia.audio.AudioWaveform
            android:id="@+id/audio_waveform_view"
            android:layout_width="match_parent"
            android:layout_height="92dp"
            android:layout_marginVertical="6dp"
            android:paddingVertical="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="6dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/action_cancel_recording"
                style="@style/Widget.Foundation.AttachmentRecorderButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:contentDescription="@string/discard"
                app:icon="@drawable/symbol_delete"
                app:iconPadding="0dp"
                app:iconSize="22dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/action_start_recording"
                style="@style/Widget.Foundation.AttachmentRecorderButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:clickable="true"
                android:contentDescription="@string/record_voice"
                android:focusable="true"
                android:padding="10dp"
                app:backgroundTint="?attr/foundationBackground"
                app:icon="@drawable/symbol_radio_button_checked"
                app:iconPadding="0dp"
                app:iconSize="50dp"
                app:iconTint="?attr/foundationEmphasis"
                app:strokeColor="?attr/foundationEmphasis"
                app:strokeWidth="@dimen/foundation_shape_hairline" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/action_save_recording"
                style="@style/Widget.Foundation.AttachmentRecorderButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:clickable="true"
                android:focusable="true"
                app:iconPadding="0dp"
                android:contentDescription="@string/save_voice"
                app:iconSize="22dp" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:visibility="gone"
        android:id="@+id/play_buttons_layout"
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:layout_height="match_parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/audio_file_imageview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="2dp"
            android:minHeight="92dp"
            android:paddingVertical="6dp"
            android:src="@drawable/symbol_audio_file"
            android:tint="?attr/foundationOnBackgroundMuted" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/audio_progress_indicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:progress="0"
            app:indicatorColor="?attr/foundationProgressFill"
            app:trackColor="?attr/foundationProgressTrack" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="8dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="visible">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/action_rewind"
                style="@style/Widget.Foundation.AttachmentRecorderButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:clickable="true"
                android:focusable="true"
                android:enabled="false"
                android:contentDescription="@string/note_editor_audio_back_five_seconds"
                app:icon="@drawable/symbol_replay_5"
                app:iconPadding="0dp"
                app:iconSize="22dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/action_play_recording"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/action_play_recording"
                style="@style/Widget.Foundation.AttachmentRecorderButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:clickable="true"
                android:focusable="true"
                android:padding="10dp"
                app:backgroundTint="?attr/foundationBackground"
                android:contentDescription="@string/play_recording"
                app:icon="@drawable/symbol_play_arrow"
                app:iconPadding="0dp"
                app:iconSize="50dp"
                app:iconTint="?attr/foundationEmphasis"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeColor="?attr/foundationEmphasis"
                app:strokeWidth="@dimen/foundation_shape_hairline" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/action_forward"
                style="@style/Widget.Foundation.AttachmentRecorderButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:clickable="true"
                android:focusable="true"
                android:enabled="false"
                android:contentDescription="@string/note_editor_audio_forward_five_seconds"
                app:icon="@drawable/symbol_forward_5"
                app:iconPadding="0dp"
                app:iconSize="22dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/action_play_recording"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/action_discard_recording"
                style="@style/Widget.Foundation.AttachmentRecorderButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:contentDescription="@string/discard"
                app:icon="@drawable/symbol_delete"
                app:iconPadding="0dp"
                app:iconSize="22dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/action_forward"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:dividerColor="?attr/foundationOutline"
        app:dividerThickness="@dimen/foundation_shape_hairline" />
</LinearLayout>