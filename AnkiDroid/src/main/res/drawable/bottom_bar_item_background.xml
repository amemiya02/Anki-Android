<!-- A bottom bar tab: the current one is marked by a short cinnabar rule over the bar's hairline -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item
                android:gravity="top|center_horizontal"
                android:width="@dimen/bottom_bar_current_rule_width"
                android:height="@dimen/foundation_shape_current_tab_rule">
                <shape android:shape="rectangle">
                    <solid android:color="?attr/foundationEmphasis" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
