<!-- A hairline on the start edge: Quiet paper separates panes with a rule, not a shadow -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="@dimen/foundation_shape_hairline"
        android:gravity="start|fill_vertical">
        <shape android:shape="rectangle">
            <solid android:color="?attr/foundationOutline" />
        </shape>
    </item>
</layer-list>
