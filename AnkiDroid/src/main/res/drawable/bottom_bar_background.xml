<!-- The bottom bar: the page's own colour, with a hairline along its top edge -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/foundationBackground" />
        </shape>
    </item>
    <item
        android:gravity="top"
        android:height="@dimen/foundation_shape_hairline">
        <shape android:shape="rectangle">
            <solid android:color="?attr/foundationOutline" />
        </shape>
    </item>
</layer-list>
